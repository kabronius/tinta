<?xml version="1.0" encoding="UTF-8"?>
<addon id="skin.tinta" version="0.2.0" name="Tinta" provider-name="Noel Perez">
	<requires>
		<import addon="xbmc.gui" version="5.17.0"/>
		<import addon="script.tinta.colors" version="0.2.0"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml"/>
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml"/>
		<res width="2250" height="1080" aspect="18.75:9" default="false" folder="xml"/>
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml"/>
		<res width="2400" height="1080" aspect="20:9" default="false" folder="xml"/>
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml"/>
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<source>https://github.com/kabronius/tinta</source>
		<summary lang="en_GB">Material You skin for phones</summary>
		<summary lang="it_IT">Skin Material You per telefoni</summary>
		<description lang="en_GB">Touch-first skin for Kodi Omega on phones in landscape, following Material 3 (Material You). Colors follow the artwork of the focused item.</description>
		<description lang="it_IT">Skin pensata per il touch, per Kodi Omega su telefono in orizzontale, secondo Material 3 (Material You). I colori seguono la copertina dell'elemento selezionato.</description>
		<license>Apache-2.0; fonts: Roboto (OFL-1.1), Material Symbols (Apache-2.0)</license>
	</extension>
</addon>
