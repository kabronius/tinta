<?xml version="1.0" encoding="UTF-8"?>
<!-- M3 type scale in skin px (1 sp = 2.75 px: 1080 px high screen at ~460 dpi).
     font10..font14 are required by the Kodi core. -->
<fonts>
	<fontset id="Default" idloc="31000">
		<!-- required by the core -->
		<font><name>font10</name><filename>Roboto-Regular.ttf</filename><size>33</size></font>
		<font><name>font12</name><filename>Roboto-Regular.ttf</filename><size>38</size></font>
		<font><name>font13</name><filename>Roboto-Regular.ttf</filename><size>44</size></font>
		<font><name>font14</name><filename>Roboto-Regular.ttf</filename><size>44</size></font>
		<!-- Material 3 -->
		<font><name>display_s</name><filename>Roboto-Regular.ttf</filename><size>99</size></font>
		<font><name>headline_m</name><filename>Roboto-Regular.ttf</filename><size>77</size></font>
		<font><name>headline_s</name><filename>Roboto-Regular.ttf</filename><size>66</size></font>
		<font><name>title_l</name><filename>Roboto-Regular.ttf</filename><size>60</size></font>
		<font><name>title_m</name><filename>Roboto-Medium.ttf</filename><size>44</size></font>
		<font><name>title_s</name><filename>Roboto-Medium.ttf</filename><size>38</size></font>
		<font><name>body_l</name><filename>Roboto-Regular.ttf</filename><size>44</size></font>
		<font><name>body_m</name><filename>Roboto-Regular.ttf</filename><size>38</size></font>
		<font><name>body_s</name><filename>Roboto-Regular.ttf</filename><size>33</size></font>
		<font><name>body_m_lines</name><filename>Roboto-Regular.ttf</filename><size>38</size><linespacing>1.3</linespacing></font>
		<font><name>label_l</name><filename>Roboto-Medium.ttf</filename><size>38</size></font>
		<font><name>label_m</name><filename>Roboto-Medium.ttf</filename><size>33</size></font>
		<font><name>label_s</name><filename>Roboto-Medium.ttf</filename><size>30</size></font>
		<!-- Material Symbols Rounded icons (24dp = 66 px) -->
		<font><name>icon</name><filename>Symbols-Outline.ttf</filename><size>66</size></font>
		<font><name>icon_fill</name><filename>Symbols-Filled.ttf</filename><size>66</size></font>
		<font><name>icon_s</name><filename>Symbols-Outline.ttf</filename><size>50</size></font>
		<font><name>icon_s_fill</name><filename>Symbols-Filled.ttf</filename><size>50</size></font>
		<font><name>icon_l</name><filename>Symbols-Outline.ttf</filename><size>88</size></font>
		<font><name>icon_l_fill</name><filename>Symbols-Filled.ttf</filename><size>88</size></font>
		<font><name>icon_xl_fill</name><filename>Symbols-Filled.ttf</filename><size>121</size></font>
	</fontset>
</fonts>
