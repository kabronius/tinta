<?xml version="1.0" encoding="UTF-8"?>
<!-- Yes/No, OK and progress. Core ids: 1 heading, 9 text, 20 progress, 10 no/cancel, 11 yes, 12 custom. -->
<window>
	<defaultcontrol always="true">11</defaultcontrol>
	<include>AnimDialog</include>
	<controls>
		<include content="DialogFrame">
			<param name="width">1540</param>
			<param name="height">616</param>
		</include>
		<control type="group">
			<centerleft>50%</centerleft><centertop>50%</centertop>
			<width>1540</width><height>616</height>
			<control type="textbox" id="9">
				<left>66</left><top>165</top><right>66</right><height>264</height>
				<font>body_m_lines</font>
				<textcolor>$VAR[c_on_surface_variant]</textcolor>
				<autoscroll time="3000" delay="4000" repeat="5000">true</autoscroll>
			</control>
			<control type="progress" id="20">
				<left>66</left><top>440</top><right>66</right><height>11</height>
				<texturebg colordiffuse="$VAR[c_secondary_container]">white.png</texturebg>
				<midtexture colordiffuse="$VAR[c_primary]">white.png</midtexture>
				<info>System.Progressbar</info>
			</control>
			<control type="grouplist" id="9000">
				<left>66</left><right>44</right><bottom>44</bottom><height>110</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>22</itemgap>
				<include content="DialogButton"><param name="id">12</param></include>
				<include content="DialogButton"><param name="id">10</param></include>
				<include content="DialogButtonFilled"><param name="id">11</param></include>
			</control>
		</control>
	</controls>
</window>
