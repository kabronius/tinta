<?xml version="1.0" encoding="UTF-8"?>
<includes>
	<!-- ===== Navigation ===== -->
	<expression name="MediaContent">[Container.Content(movies) | Container.Content(tvshows) | Container.Content(seasons) | Container.Content(sets) | Container.Content(videos)]</expression>
	<expression name="MediaAsPosters">$EXP[MediaContent] + !Skin.HasSetting(media_as_list)</expression>
	<expression name="InLive">!String.IsEmpty(Skin.String(tinta.live.path)) + String.IsEqual(Container.FolderPath,Skin.String(tinta.live.path))</expression>
	<expression name="RailItemActive">[String.IsEqual(ListItem.Property(id),home) + Window.IsActive(home)] | [String.IsEqual(ListItem.Property(id),movies) + Window.IsActive(1110)] | [String.IsEqual(ListItem.Property(id),shows) + Window.IsActive(1111)] | [String.IsEqual(ListItem.Property(id),live) + Window.IsActive(videos) + $EXP[InLive]] | [String.IsEqual(ListItem.Property(id),addons) + Window.IsActive(videos) + !$EXP[InLive]]</expression>

	<variable name="SearchAction">
		<value condition="!String.IsEmpty(Skin.String(tinta.search.path))">ActivateWindow(Videos,"$INFO[Skin.String(tinta.search.path)]",return)</value>
		<value>ActivateWindow(Videos,addons://sources/video/,return)</value>
	</variable>
	<variable name="RailOnRight">
		<value condition="Window.IsActive(home)">SetFocus(5000)</value>
		<value condition="Window.IsActive(1110)">SetFocus(11100)</value>
		<value condition="Window.IsActive(1111)">SetFocus(11110)</value>
		<value>SetFocus(50)</value>
	</variable>

	<variable name="NavTitle">
		<value condition="!String.IsEmpty(Container.FolderName)">$INFO[Container.FolderName]</value>
		<value condition="!String.IsEmpty(Container.PluginName)">$INFO[System.AddonTitle($INFO[Container.PluginName])]</value>
		<value>$LOCALIZE[3]</value>
	</variable>
	<variable name="ViewToggleIcon">
		<value condition="Skin.HasSetting(media_as_list)">{ic:grid_view}</value>
		<value>{ic:view_list}</value>
	</variable>

	<variable name="ResumeAwareBg">
		<value condition="Control.IsEnabled(9)">$VAR[c_secondary_container]</value>
		<value>$VAR[c_primary]</value>
	</variable>
	<variable name="ResumeAwareFg">
		<value condition="Control.IsEnabled(9)">$VAR[c_on_secondary_container]</value>
		<value>$VAR[c_on_primary]</value>
	</variable>

	<!-- ===== Images ===== -->
	<variable name="PosterImage">
		<value condition="!String.IsEmpty(ListItem.Art(poster))">$INFO[ListItem.Art(poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.poster))">$INFO[ListItem.Art(tvshow.poster)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
		<value>$INFO[ListItem.Icon]</value>
	</variable>
	<variable name="LandscapeImage">
		<value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value>$INFO[ListItem.Art(thumb)]</value>
	</variable>
	<variable name="FanartImage">
		<value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
		<value condition="!String.IsEmpty(ListItem.Art(tvshow.fanart))">$INFO[ListItem.Art(tvshow.fanart)]</value>
		<value>$INFO[ListItem.Art(landscape)]</value>
	</variable>

	<!-- ===== Text ===== -->
	<variable name="HeroTitle">
		<value condition="!String.IsEmpty(ListItem.TVShowTitle)">$INFO[ListItem.TVShowTitle]</value>
		<value>$INFO[ListItem.Label]</value>
	</variable>
	<variable name="RowIcon">
		<value condition="ListItem.IsParentFolder">{ic:arrow_back}</value>
		<value condition="ListItem.IsFolder">{ic:folder}</value>
		<value>{ic:play_arrow}</value>
	</variable>
	<variable name="RowSubtitle">
		<value condition="!String.IsEmpty(ListItem.Year) | String.IsEqual(ListItem.DBType,episode)">$VAR[ItemSubtitle]</value>
		<value condition="!String.IsEmpty(ListItem.Plot)">$INFO[ListItem.Plot]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>
	<variable name="ItemSubtitle">
		<value condition="String.IsEqual(ListItem.DBType,episode)">$INFO[ListItem.Season,$LOCALIZE[20373] , · ]$INFO[ListItem.Episode,$LOCALIZE[20359] ]</value>
		<value condition="!String.IsEmpty(ListItem.Year)">$INFO[ListItem.Year]$INFO[ListItem.Genre, · ]</value>
		<value>$INFO[ListItem.Label2]</value>
	</variable>
	<variable name="DetailMeta">
		<value>$INFO[ListItem.Year]$INFO[ListItem.Duration(hh:mm), · ]$INFO[ListItem.MPAA, · ]</value>
	</variable>
	<variable name="Greeting">
		<value condition="System.Time(00:00,05:00)">$LOCALIZE[31004]</value>
		<value condition="System.Time(05:00,13:00)">$LOCALIZE[31001]</value>
		<value condition="System.Time(13:00,18:00)">$LOCALIZE[31002]</value>
		<value>$LOCALIZE[31003]</value>
	</variable>
	<!-- ===== Player ===== -->
	<variable name="OSDTitle">
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.TVShowTitle]</value>
		<value>$INFO[VideoPlayer.Title]</value>
	</variable>
	<variable name="OSDSubtitle">
		<value condition="!String.IsEmpty(VideoPlayer.TVShowTitle)">$INFO[VideoPlayer.Season,$LOCALIZE[20373] , · ]$INFO[VideoPlayer.Episode,$LOCALIZE[20359] , — ]$INFO[VideoPlayer.Title]</value>
		<value>$INFO[VideoPlayer.VideoResolution,,p]$INFO[VideoPlayer.HdrType, · ]$INFO[VideoPlayer.Year, · ]</value>
	</variable>
	<variable name="PlayPauseIcon">
		<value condition="Player.Paused | Player.Forwarding | Player.Rewinding">{ic:play_arrow}</value>
		<value>{ic:pause}</value>
	</variable>
	<variable name="SubtitleChipLabel">
		<value condition="VideoPlayer.SubtitlesEnabled + !String.IsEmpty(VideoPlayer.SubtitlesLanguage)">$INFO[VideoPlayer.SubtitlesLanguage]</value>
		<value>$LOCALIZE[287]</value>
	</variable>
	<variable name="VolumeIcon">
		<value condition="Player.Muted">{ic:volume_off}</value>
		<value>{ic:volume_up}</value>
	</variable>
</includes>
