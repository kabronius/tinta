<?xml version="1.0" encoding="UTF-8"?>
<!-- M3 dialogs: surfaceContainerHigh container, 28dp radius (77), 24dp padding (66). -->
<includes>
	<include name="DialogFrame">
		<param name="width">1540</param>
		<param name="height">880</param>
		<param name="header_id">1</param>
		<param name="header_label"></param>
		<definition>
			<include>Scrim</include>
			<control type="group">
				<centerleft>50%</centerleft><centertop>50%</centertop>
				<width>$PARAM[width]</width><height>$PARAM[height]</height>
				<include content="Shape">
					<param name="r">77</param>
					<param name="color">$VAR[c_surface_container_high]</param>
				</include>
				<control type="label" id="$PARAM[header_id]">
					<left>66</left><top>55</top><right>66</right><height>88</height>
					<label>$PARAM[header_label]</label>
					<font>headline_s</font>
					<textcolor>$VAR[c_on_surface]</textcolor>
					<aligny>center</aligny>
				</control>
			</control>
		</definition>
	</include>

	<!-- dialog text button (40dp = 110), automatic width -->
	<include name="DialogButton">
		<param name="label"></param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width><height>110</height>
				<label>$PARAM[label]</label>
				<font>label_l</font>
				<textoffsetx>66</textoffsetx>
				<align>center</align><aligny>center</aligny>
				<textcolor>$VAR[c_primary]</textcolor>
				<focusedcolor>$VAR[c_primary]</focusedcolor>
				<disabledcolor>61FFFFFF</disabledcolor>
				<texturenofocus/>
				<texturefocus border="55" colordiffuse="1FFFFFFF">shapes/r55.png</texturefocus>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
	<!-- dialog filled button -->
	<include name="DialogButtonFilled">
		<param name="label"></param>
		<param name="visible">true</param>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>auto</width><height>110</height>
				<label>$PARAM[label]</label>
				<font>label_l</font>
				<textoffsetx>66</textoffsetx>
				<align>center</align><aligny>center</aligny>
				<textcolor>$VAR[c_on_primary]</textcolor>
				<focusedcolor>$VAR[c_on_primary]</focusedcolor>
				<disabledcolor>$VAR[c_on_primary]</disabledcolor>
				<texturenofocus border="55" colordiffuse="$VAR[c_primary]">shapes/r55.png</texturenofocus>
				<texturefocus border="55" colordiffuse="$VAR[c_primary]">shapes/r55.png</texturefocus>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>

	<!-- dialog list row (56dp = 154): Label, Label2, icon -->
	<include name="DialogListRow">
		<param name="width">1408</param>
		<param name="list">3</param>
		<definition>
			<control type="group">
				<width>$PARAM[width]</width><height>154</height>
				<include content="Shape">
					<param name="r">44</param>
					<param name="color">$VAR[c_secondary_container]</param>
					<param name="visible">ListItem.IsSelected</param>
				</include>
				<include content="Shape">
					<param name="r">44</param>
					<param name="color">1FFFFFFF</param>
					<param name="visible">$PARAM[focus] + Control.HasFocus($PARAM[list])</param>
				</include>
				<control type="image">
					<right>44</right><top>33</top><width>88</width><height>88</height>
					<texture diffuse="masks/square.png">$INFO[ListItem.Icon]</texture>
					<aspectratio>keep</aspectratio>
					<visible>!String.IsEmpty(ListItem.Icon) + !String.StartsWith(ListItem.Icon,Default)</visible>
				</control>
				<control type="label">
					<left>55</left><right>176</right><top>11</top><height>77</height>
					<label>$INFO[ListItem.Label]</label>
					<font>body_l</font>
					<textcolor>$VAR[c_on_surface]</textcolor>
					<selectedcolor>$VAR[c_on_secondary_container]</selectedcolor>
					<aligny>center</aligny>
					<visible>!String.IsEmpty(ListItem.Label2)</visible>
				</control>
				<control type="label">
					<left>55</left><right>176</right><top>82</top><height>55</height>
					<label>$INFO[ListItem.Label2]</label>
					<font>body_m</font>
					<textcolor>$VAR[c_on_surface_variant]</textcolor>
					<selectedcolor>$VAR[c_on_secondary_container]</selectedcolor>
					<aligny>center</aligny>
					<visible>!String.IsEmpty(ListItem.Label2)</visible>
				</control>
				<control type="label">
					<left>55</left><right>176</right><top>0</top><height>154</height>
					<label>$INFO[ListItem.Label]</label>
					<font>body_l</font>
					<textcolor>$VAR[c_on_surface]</textcolor>
					<selectedcolor>$VAR[c_on_secondary_container]</selectedcolor>
					<aligny>center</aligny>
					<visible>String.IsEmpty(ListItem.Label2)</visible>
				</control>
			</control>
		</definition>
	</include>

	<!-- ===== Keyboard keys ===== -->
	<include name="KeyCommon">
		<align>center</align><aligny>center</aligny>
		<textoffsetx>0</textoffsetx>
		<textureradioonfocus border="33" colordiffuse="4DFFFFFF">shapes/r33.png</textureradioonfocus>
		<textureradioonnofocus border="33" colordiffuse="4DFFFFFF">shapes/r33.png</textureradioonnofocus>
		<textureradioofffocus/><textureradiooffnofocus/>
		<radioposx>0</radioposx><radioposy>0</radioposy>
		<radiowidth>-1</radiowidth><radioheight>-1</radioheight>
	</include>
	<include name="KeyStyle">
		<include>KeyCommon</include>
		<font>title_l</font>
		<textcolor>$VAR[c_on_surface]</textcolor>
		<focusedcolor>$VAR[c_on_surface]</focusedcolor>
		<texturenofocus border="33" colordiffuse="$VAR[c_surface_container_high]">shapes/r33.png</texturenofocus>
		<texturefocus border="33" colordiffuse="$VAR[c_surface_container_highest]">shapes/r33.png</texturefocus>
	</include>
	<include name="KeyStyleFn">
		<include>KeyCommon</include>
		<font>title_m</font>
		<textcolor>$VAR[c_on_secondary_container]</textcolor>
		<focusedcolor>$VAR[c_on_secondary_container]</focusedcolor>
		<texturenofocus border="33" colordiffuse="$VAR[c_secondary_container]">shapes/r33.png</texturenofocus>
		<texturefocus border="33" colordiffuse="$VAR[c_secondary_container]">shapes/r33.png</texturefocus>
	</include>
	<include name="KeyStyleFnIcon">
		<include>KeyCommon</include>
		<font>icon</font>
		<textcolor>$VAR[c_on_secondary_container]</textcolor>
		<focusedcolor>$VAR[c_on_secondary_container]</focusedcolor>
		<texturenofocus border="33" colordiffuse="$VAR[c_secondary_container]">shapes/r33.png</texturenofocus>
		<texturefocus border="33" colordiffuse="$VAR[c_secondary_container]">shapes/r33.png</texturefocus>
	</include>
	<include name="KeyStyleDone">
		<include>KeyCommon</include>
		<font>icon</font>
		<textcolor>$VAR[c_on_primary]</textcolor>
		<focusedcolor>$VAR[c_on_primary]</focusedcolor>
		<texturenofocus border="33" colordiffuse="$VAR[c_primary]">shapes/r33.png</texturenofocus>
		<texturefocus border="33" colordiffuse="$VAR[c_primary]">shapes/r33.png</texturefocus>
	</include>
	<include name="KeyStyleIcon">
		<include>KeyCommon</include>
		<font>icon</font>
		<textcolor>$VAR[c_on_surface_variant]</textcolor>
		<focusedcolor>$VAR[c_on_surface]</focusedcolor>
		<texturenofocus/>
		<texturefocus colordiffuse="1FFFFFFF">shapes/circle.png</texturefocus>
	</include>

	<!-- ===== Setting controls (ids 7-15, used by the core as templates) ===== -->
	<include name="SettingTemplates">
		<param name="width">1700</param>
		<param name="textwidth">900</param>
		<param name="radiox">1513</param>
		<definition>
			<control type="button" id="7">
				<width>$PARAM[width]</width><height>154</height>
				<include>SettingRowStyle</include>
			</control>
			<control type="radiobutton" id="8">
				<width>$PARAM[width]</width><height>154</height>
				<include>SettingRowStyle</include>
				<textureradioonfocus colordiffuse="$VAR[c_primary]">shapes/switch_on.png</textureradioonfocus>
				<textureradioonnofocus colordiffuse="$VAR[c_primary]">shapes/switch_on.png</textureradioonnofocus>
				<textureradioofffocus colordiffuse="$VAR[c_outline]">shapes/switch_off.png</textureradioofffocus>
				<textureradiooffnofocus colordiffuse="$VAR[c_outline]">shapes/switch_off.png</textureradiooffnofocus>
				<radiowidth>143</radiowidth><radioheight>88</radioheight>
				<radioposx>$PARAM[radiox]</radioposx>
			</control>
			<control type="spincontrolex" id="9">
				<width>$PARAM[width]</width><height>154</height>
				<include>SettingRowStyle</include>
				<textureup/><textureupfocus/><texturedown/><texturedownfocus/>
				<textureupdisabled/><texturedowndisabled/>
				<spinwidth>0</spinwidth><spinheight>0</spinheight>
				<textwidth>$PARAM[textwidth]</textwidth>
			</control>
			<control type="image" id="11">
				<width>$PARAM[width]</width><height>3</height>
				<texture colordiffuse="$VAR[c_outline_variant]">white.png</texture>
			</control>
			<control type="edit" id="12">
				<width>$PARAM[width]</width><height>154</height>
				<include>SettingRowStyle</include>
			</control>
			<control type="sliderex" id="13">
				<width>$PARAM[width]</width><height>154</height>
				<include>SettingRowStyle</include>
				<texturesliderbar border="22" colordiffuse="$VAR[c_secondary_container]">shapes/slider_bar.png</texturesliderbar>
				<textureslidernib colordiffuse="$VAR[c_primary]">shapes/slider_nib.png</textureslidernib>
				<textureslidernibfocus colordiffuse="$VAR[c_primary]">shapes/slider_nib.png</textureslidernibfocus>
				<sliderwidth>440</sliderwidth><sliderheight>44</sliderheight>
				<textwidth>$PARAM[textwidth]</textwidth>
			</control>
			<control type="label" id="14">
				<width>$PARAM[width]</width><height>110</height>
				<font>title_s</font>
				<textcolor>$VAR[c_primary]</textcolor>
				<aligny>bottom</aligny>
				<textoffsetx>44</textoffsetx>
			</control>
			<control type="colorbutton" id="15">
				<width>$PARAM[width]</width><height>154</height>
				<include>SettingRowStyle</include>
				<colorwidth>88</colorwidth><colorheight>88</colorheight>
				<texturecolormask>shapes/circle.png</texturecolormask>
				<texturecolordisabledmask>shapes/circle.png</texturecolordisabledmask>
			</control>
		</definition>
	</include>
	<include name="SettingRowStyle">
		<font>body_l</font>
		<textoffsetx>44</textoffsetx>
		<aligny>center</aligny>
		<textcolor>$VAR[c_on_surface]</textcolor>
		<focusedcolor>$VAR[c_on_surface]</focusedcolor>
		<disabledcolor>61FFFFFF</disabledcolor>
		<texturenofocus/>
		<texturefocus border="44" colordiffuse="1FFFFFFF">shapes/r44.png</texturefocus>
	</include>
	<!-- skin settings switch -->
	<include name="SkinToggleStyle">
		<include>SettingRowStyle</include>
		<textureradioonfocus colordiffuse="$VAR[c_primary]">shapes/switch_on.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[c_primary]">shapes/switch_on.png</textureradioonnofocus>
		<textureradioofffocus colordiffuse="$VAR[c_outline]">shapes/switch_off.png</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="$VAR[c_outline]">shapes/switch_off.png</textureradiooffnofocus>
		<radiowidth>143</radiowidth><radioheight>88</radioheight>
		<radioposx>1513</radioposx>
	</include>
	<!-- skin settings single choice (radio) -->
	<include name="SkinChoiceStyle">
		<include>SettingRowStyle</include>
		<textureradioonfocus colordiffuse="$VAR[c_primary]">shapes/choice_on.png</textureradioonfocus>
		<textureradioonnofocus colordiffuse="$VAR[c_primary]">shapes/choice_on.png</textureradioonnofocus>
		<textureradioofffocus colordiffuse="$VAR[c_outline]">shapes/choice_off.png</textureradioofffocus>
		<textureradiooffnofocus colordiffuse="$VAR[c_outline]">shapes/choice_off.png</textureradiooffnofocus>
		<radiowidth>66</radiowidth><radioheight>66</radioheight>
		<radioposx>1590</radioposx>
	</include>
	<!-- category button (list on the left in settings) -->
	<include name="CategoryButtonStyle">
		<font>label_l</font>
		<textoffsetx>55</textoffsetx>
		<aligny>center</aligny>
		<textcolor>$VAR[c_on_surface_variant]</textcolor>
		<focusedcolor>$VAR[c_on_secondary_container]</focusedcolor>
		<texturenofocus/>
		<texturefocus border="77" colordiffuse="$VAR[c_secondary_container]">shapes/r77.png</texturefocus>
	</include>
</includes>
