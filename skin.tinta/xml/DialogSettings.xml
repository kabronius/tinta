<?xml version="1.0" encoding="UTF-8"?>
<!-- Settings dialogs (player audio/subtitles/video, ...) as a side sheet.
     Core ids: 2 heading, 5 settings, 6 description, 28 OK, 29 cancel, 30 custom, 7-15 templates. -->
<window>
	<defaultcontrol always="true">5</defaultcontrol>
	<include>AnimSheetRight</include>
	<controls>
		<include>Scrim</include>
		<control type="group">
			<left>963</left><top>22</top><width>1265</width><height>1036</height>
			<include content="Shape">
				<param name="r">77</param>
				<param name="color">$VAR[c_surface_container_low]</param>
			</include>
			<control type="label" id="2">
				<left>66</left><top>44</top><right>66</right><height>88</height>
				<font>headline_s</font>
				<textcolor>$VAR[c_on_surface]</textcolor>
				<aligny>center</aligny>
			</control>
			<control type="grouplist" id="5">
				<left>33</left><top>176</top><width>1199</width><height>684</height>
				<itemgap>0</itemgap>
				<ondown>9000</ondown>
				<pagecontrol>60</pagecontrol>
			</control>
			<control type="scrollbar" id="60">
				<left>1243</left><top>176</top><width>8</width><height>684</height>
				<texturesliderbackground/>
				<texturesliderbar colordiffuse="$VAR[c_outline_variant]">white.png</texturesliderbar>
				<texturesliderbarfocus colordiffuse="$VAR[c_outline]">white.png</texturesliderbarfocus>
				<orientation>vertical</orientation>
			</control>
			<control type="textbox" id="6"><left>0</left><top>0</top><width>1</width><height>1</height><visible>false</visible></control>
			<control type="grouplist" id="9000">
				<left>66</left><right>44</right><bottom>44</bottom><height>110</height>
				<orientation>horizontal</orientation>
				<align>right</align>
				<itemgap>22</itemgap>
				<onup>5</onup>
				<include content="DialogButton"><param name="id">30</param></include>
				<include content="DialogButton"><param name="id">29</param></include>
				<include content="DialogButtonFilled"><param name="id">28</param></include>
			</control>
		</control>
		<include content="SettingTemplates">
			<param name="width">1199</param>
			<param name="radiox">1012</param>
			<param name="textwidth">470</param>
		</include>
	</controls>
</window>
